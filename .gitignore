node_modules/
.venv/
__pycache__/
.ruff_cache/
.DS_Store

# Rendered outputs and caches are rebuilt, never committed.
out/
*.mp4
*.mov
*.wav
**/out/

# Mixkit audio is fetched by tools/audio/fetch-sfx.mjs; its licence forbids redistribution.
tools/audio/sfx/fetched/

# Test scratch (template films, generated fixture images).
**/.tmp-films/
**/.assets/

# Kit working folders and reference captures.
kit/sources/
kit/pieces/
kit/out/

# Copyrighted reel frames and videos stay local; only the study notes are committed.
inspirations/**/frames/
inspirations/**/media/
inspirations/**/cache/
tutorials/*/cache/
tools/kit/reference/ocr

# Remotion official skills: no licence, fetched by tools/skills/sync-remotion-skills.sh.
skills/remotion/*/

# whisper.cpp build + ggml model downloaded by tools/captions/transcribe.mjs.
tools/captions/.whisper/
inspirations/clone-candidates/
