{
  "name": "motion-studio",
  "version": "0.1.0",
  "description": "Technique library for code-rendered documentary and explainer films, built on Remotion.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./film/gate": "./src/film/gate.ts"
  },
  "scripts": {
    "dev": "remotion studio studio/index.ts",
    "assets": "bash tools/assets/make-vo.sh",
    "check:assets": "node tools/assets/check-assets.mjs",
    "prerender": "npm run check:assets",
    "render": "remotion render studio/index.ts",
    "compositions": "remotion compositions studio/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:tools": "node --test tools/*/tests/*.test.mjs",
    "fetch-sfx": "node tools/audio/fetch-sfx.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "remotion": "4.0.538",
    "@react-three/fiber": "9.3.0",
    "@remotion/captions": "4.0.538",
    "@remotion/effects": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/layout-utils": "4.0.538",
    "@remotion/motion-blur": "4.0.538",
    "@remotion/paths": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "@remotion/three": "4.0.538",
    "three": "0.178.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "@remotion/captions": {
      "optional": true
    },
    "@remotion/effects": {
