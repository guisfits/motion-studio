    },
    "@remotion/fonts": {
      "optional": true
    },
    "@remotion/layout-utils": {
      "optional": true
    },
    "@remotion/motion-blur": {
      "optional": true
    },
    "@remotion/paths": {
      "optional": true
    },
    "@remotion/transitions": {
      "optional": true
    },
    "@remotion/three": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "playwright": "1.55.0"
  },
  "devDependencies": {
    "@react-three/fiber": "9.3.0",
    "@remotion/captions": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/effects": "4.0.538",
